---
import { t, type Lang } from '../i18n';
import { EMAIL, LINKEDIN_URL, INSTAGRAM_URL } from '../config';
import Social from './Social.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const hasSocial = Boolean(LINKEDIN_URL || INSTAGRAM_URL);
const s = t(lang).contact;
---
<section id="contacte">
  <div class="wrap">
    <p class="kicker rv"><b>08</b><span>{s.kicker}</span></p>
    <div class="contact-grid">
      <div>
        <h2 class="rv" style="margin-bottom:1.5rem">{s.h2}</h2>
        <a class="mailto rv" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <div class="btns rv contact-cta">
          <a class="btn" href={`mailto:${EMAIL}`}>{s.cta} <span class="ar">→</span></a>
        </div>
        {hasSocial && (
          <p class="follow rv">
            <span class="mono">{t(lang).social.follow}</span>
            <Social lang={lang} labels />
          </p>
        )}
      </div>

      <div class="contact-side">
        <address class="rv">
          <span class="mono">{s.hqLabel}</span>
          {s.hq1}<br />{s.hq2}<br />{s.hq3}
        </address>
        <p class="rv mono" style="color:var(--color-faint);margin-top:2rem;line-height:2">{s.topics}</p>
      </div>
    </div>
  </div>
</section>
