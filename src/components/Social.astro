---
import { t, type Lang } from '../i18n';
import { LINKEDIN_URL, INSTAGRAM_URL } from '../config';
interface Props {
  lang: Lang;
  /** Mostra el nom de la xarxa al costat de la icona. */
  labels?: boolean;
  class?: string;
}
const { lang, labels = false, class: cls } = Astro.props;
const s = t(lang).social;
const links = [
  { name: 'LinkedIn', url: LINKEDIN_URL, aria: s.linkedin, icon: 'linkedin' },
  { name: 'Instagram', url: INSTAGRAM_URL, aria: s.instagram, icon: 'instagram' },
].filter((l) => l.url);
---
{links.map((l) => (
  <a class:list={['social', cls]} href={l.url} target="_blank" rel="noopener noreferrer" aria-label={l.aria}>
    {l.icon === 'linkedin' && (
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
    )}
    {l.icon === 'instagram' && (
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r=".9" fill="currentColor" stroke="none"/></svg>
    )}
    {labels && <span>{l.name}</span>}
  </a>
))}
