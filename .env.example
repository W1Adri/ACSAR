# Copia aquest fitxer a .env i omple els valors.
#
# ID del formulari de contacte. Es crea a https://formspree.io:
#   New form → nom del formulari → correu on han d'arribar els missatges
#   → copia la part final de l'endpoint (https://formspree.io/f/XXXXXXXX)
# Sense aquest valor el formulari no envia: mostra l'avís amb l'adreça de correu.
PUBLIC_FORMSPREE_ID=xxxxxxxx
